NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Manual pilot works without Paddle. Switch only after applying the billing migration.
BILLING_PROVIDER=manual

# Paddle Billing (separate sandbox and live credentials; API key/secret server-only).
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STANDARD=
# Client-side token is public by design, NEVER put PADDLE_API_KEY here.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
